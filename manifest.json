{
    "manifest_version": 3,
    "name": "IT Translator",
    "version": "1.0.0",
    "description": "Context-aware translation utility for IT specialists, powered by a local fine-tuned LLM.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "contextMenus",
        "sidePanel",
        "notifications"
    ],
    "side_panel": {
        "default_path": "src/sidepanel/index.html"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "sandbox": {
        "pages": [
            "src/sidepanel/sandbox.html"
        ]
    },
    "host_permissions": [
        "http://127.0.0.1/*"
    ],
    "action": {
        "default_popup": "src/popup/index.html"
    },
    "background": {
        "service_worker": "src/background/index.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content_script/index.js"
            ]
        }
    ]
}